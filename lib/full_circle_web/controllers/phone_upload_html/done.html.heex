<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{gettext("Done")}</title>
    <link rel="stylesheet" href={~p"/assets/app.css"} />
  </head>
  <body class="flex min-h-full items-center justify-center bg-gray-50 p-6 text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <main class="text-center">
      <p class="text-6xl">✅</p>
      <h1 class="mt-4 text-2xl font-bold">{gettext("All sent")}</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-300">
        {gettext("Your files are in FullCircle. You can close this tab.")}
      </p>
    </main>
  </body>
</html>
